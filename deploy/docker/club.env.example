# First deployment of the club only. Copy to a private club.env and verify the
# published 0.4.1 image digest before use. Never use an existing deployment volume.
COMPOSE_PROJECT_NAME=fucheng-club
FUCHENG_IMAGE=momonong/fucheng-players-system:0.4.1
FUCHENG_PUBLIC_ORIGIN=https://REPLACE_WITH_PUBLIC_HOST
FUCHENG_BASE_PATH=
FUCHENG_PROXY_KIND=cloudflare
FUCHENG_SUBNET=172.30.98.0/24
FUCHENG_APP_IP=172.30.98.2
FUCHENG_PROXY_IP=172.30.98.3
FUCHENG_BACKUP_KEEP=8
FUCHENG_BACKUP_PATH=./backup
FUCHENG_TURNSTILE_SITEKEY=REPLACE_WITH_PUBLIC_SITEKEY
FUCHENG_TURNSTILE_SECRET_FILE=./secrets/turnstile-secret.txt
# Exactly one initial account; this does not create any other administrators.
FUCHENG_BOOTSTRAP_ADMIN_USERNAME=momonong
FUCHENG_BOOTSTRAP_ADMIN_DISPLAY_NAME=陳鎮濃
# No password is included. For file bootstrap, set a protected absolute host path
# and add compose.bootstrap-admin.yaml last. Missing/invalid secret refuses serve.
# For Windows interactive Admin, omit that overlay and privately enter a password
# before Start; the username/display name above are non-secret setup information.
FUCHENG_BOOTSTRAP_ADMIN_PASSWORD_FILE=
